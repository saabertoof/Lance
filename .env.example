# Supabase project URL, found in Supabase Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use the public publishable key only.
# Never put a Supabase service-role key in this mobile app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Keeps network calls on React Native's built-in global fetch path in Expo Go.
EXPO_PUBLIC_USE_RN_FETCH=1

# Do not put OpenAI keys in this Expo file.
# Configure OPENAI_API_KEY and OPENAI_MAGIC_DRAFT_MODEL as Supabase Edge Function secrets.
